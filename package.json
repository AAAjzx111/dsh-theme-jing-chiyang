{
  "name": "dsh-theme-jing-chiyang",
  "version": "1.0.0",
  "type": "module",
  "description": "王者荣耀「镜 · 炽阳神光」动态主题：碎裂镜面 + 炽阳金辉的全屏动态背景、金曜配色与可切换动效强度。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "theme"
  ],
  "icon": "./icon-256.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon-256.png",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skin.json",
    "README.md",
    "LICENSE",
    "preview.png",
    "icon-256.png"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.js",
  "engines": {
    "dsh": ">=0.1.7"
  }
}
